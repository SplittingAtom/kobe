{
  "name": "kobe-browser-e2e",
  "private": true,
  "license": "Apache-2.0",
  "description": "Playwright browser suite for the chat surfaces, run against a deployment (not in CI).",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc -p .",
    "perf:test": "node --test perf/*.test.ts",
    "perf:measure": "playwright test -c playwright.perf.config.ts",
    "perf:bundles": "node perf/print-bundles.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "24.19.0",
    "typescript": "6.0.3"
  }
}
