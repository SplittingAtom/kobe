@layer theme, base, kobe-legacy, components, utilities
body:has([data-kobe-chat]) {
  margin: 0;
}
@layer base {
  [data-kobe-chat] *:where(:not([data-kobe-console], [data-kobe-console] *)),
  [data-kobe-chat] :where(:not([data-kobe-console], [data-kobe-console] *))::before,
  [data-kobe-chat] :where(:not([data-kobe-console], [data-kobe-console] *))::after,
  [data-slot="tooltip-content"],
  [data-slot="tooltip-content"] * {
    box-sizing: border-box;
    border-color: var(--border);
  }
  [data-kobe-chat]
    :where(button, input, select, textarea):where(
      :not([data-kobe-console], [data-kobe-console] *)
    ) {
    font: inherit;
    color: inherit;
  }
  [data-kobe-chat] :where(svg):where(:not([data-kobe-console], [data-kobe-console] *)) {
    display: block;
  }
  [data-kobe-chat]
    :where(button[data-slot]):where(:not([data-kobe-console], [data-kobe-console] *)) {
    padding: 0;
    border: 0;
    background: transparent;
  }
  [data-kobe-chat] [data-kobe-composer-box] {
    anchor-name: --kobe-composer;
  }
  [data-kobe-chat]
    :where(button:not(:disabled), [role="button"]:not(:disabled)):where(
      :not([data-kobe-console], [data-kobe-console] *)
    ) {
    cursor: pointer;
  }
  [data-kobe-chat]
    :where(button:not([data-slot])):where(:not([data-kobe-console], [data-kobe-console] *)) {
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--kobe-radius-md);
  }
  [data-kobe-chat]
    :where(button:not([data-slot]):hover:not(:disabled, [aria-disabled="true"])):where(
      :not([data-kobe-console], [data-kobe-console] *)
    ) {
    background: var(--accent);
    color: var(--accent-foreground);
  }
  [data-kobe-chat]
    :where(button:not([data-slot]):disabled):where(
      :not([data-kobe-console], [data-kobe-console] *)
    ) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  [data-kobe-chat]
    :where(input:not([type="checkbox"], [type="radio"]), select, textarea):where(
      :not([data-kobe-console], [data-kobe-console] *)
    ) {
    background: var(--background);
    border: 1px solid var(--input);
    border-radius: var(--kobe-radius-md);
  }
  [data-kobe-chat]
    :where(input, select, textarea):where(
      :not([data-kobe-console], [data-kobe-console] *)
    ):focus-visible {
    outline: none;
    border-color: var(--ring);
    box-shadow: 0 0 0 3px var(--ring);
    @supports (color: color-mix(in lab, red, red)) {
      box-shadow: 0 0 0 3px color-mix(in oklab, var(--ring) 50%, transparent);
    }
  }
}
@property --kobe-arrived {
  syntax: "<percentage>";
  inherits: false;
  initial-value: 100%;
}
@keyframes kobe-arrive {
  from {
    --kobe-arrived: 0%;
  }
  to {
    --kobe-arrived: 100%;
  }
}
[data-kobe-scroll="messages"] {
  --kobe-arrive-tint: currentColor;
}
[data-kobe-scroll="messages"][data-kobe-follow="pinned"] {
  --kobe-arrive-tint: var(--admin-accent, var(--primary));
}
[data-kobe-arrive="running"] [data-kobe-word] {
  color: currentColor;
  @supports (color: color-mix(in lab, red, red)) {
    color: color-mix(in srgb, currentColor var(--kobe-arrived), var(--kobe-arrive-tint));
  }
  animation: kobe-arrive 600ms ease-out;
}
@media (prefers-reduced-motion: reduce) {
  [data-kobe-arrive="running"] [data-kobe-word] {
    animation: none;
  }
  [data-kobe-words] > :is(p, h1, h2, h3, h4, h5, h6, ul, ol) {
    padding-inline-start: 0.5rem;
  }
  [data-kobe-follow="pinned"] [data-kobe-arrive="running"] > :last-child {
    box-shadow: inset 2px 0 0 0 var(--kobe-arrive-tint);
  }
}
[data-kobe-chat] .kobe-panel {
  transition: border-color 300ms ease,
    box-shadow 300ms ease;
}
@media (hover: hover) {
  [data-kobe-chat] .kobe-panel:hover:not(:has(.kobe-panel:hover)) {
    border-color: var(--kobe-panel-border-hover);
    box-shadow: var(--kobe-glow-panel);
  }
}
@media (prefers-reduced-motion: reduce) {
  [data-kobe-chat] .kobe-panel {
    transition: none;
  }
}
@media (forced-colors: active) {
  [data-kobe-chat] .kobe-panel:hover:not(:has(.kobe-panel:hover)) {
    border-color: Highlight;
  }
}
[data-kobe-chat] .kobe-glow-gold {
  border: 1px solid var(--kobe-glow-gold-border);
  box-shadow: 0 0 12px 1px var(--kobe-glow-gold);
  animation: kobe-glow-gold 2.4s ease-in-out infinite alternate;
}
@keyframes kobe-glow-gold {
  from {
    box-shadow: 0 0 6px 0 var(--kobe-glow-gold);
  }
  to {
    box-shadow: 0 0 14px 2px var(--kobe-glow-gold);
  }
}
@media (prefers-reduced-motion: reduce) {
  [data-kobe-chat] .kobe-glow-gold {
    animation: none;
  }
}
@media (forced-colors: active) {
  [data-kobe-chat] .kobe-glow-gold {
    border-color: Highlight;
    box-shadow: none;
  }
}
