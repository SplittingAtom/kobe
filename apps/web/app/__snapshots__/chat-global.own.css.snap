@layer theme, base, components, utilities
body:has([data-kobe-chat]) {
  margin: 0;
}
@layer base {
  [data-kobe-chat] *,
  [data-kobe-chat] ::before,
  [data-kobe-chat] ::after,
  [data-slot="tooltip-content"],
  [data-slot="tooltip-content"] * {
    box-sizing: border-box;
    border-color: var(--border);
  }
  [data-kobe-chat] :where(button, input, select, textarea) {
    font: inherit;
    color: inherit;
  }
  [data-kobe-chat] :where(svg) {
    display: block;
  }
  [data-kobe-chat] [data-kobe-composer-box] {
    anchor-name: --kobe-composer;
  }
  [data-kobe-chat] :where(button:not(:disabled), [role="button"]:not(:disabled)) {
    cursor: pointer;
  }
  [data-kobe-chat] :where(button:not([data-slot])) {
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 0.375rem;
  }
  [data-kobe-chat] :where(button:not([data-slot]):hover:not(:disabled, [aria-disabled="true"])) {
    background: var(--accent);
    color: var(--accent-foreground);
  }
  [data-kobe-chat] :where(button:not([data-slot]):disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  [data-kobe-chat] :where(input:not([type="checkbox"], [type="radio"]), select, textarea) {
    background: var(--background);
    border: 1px solid var(--input);
    border-radius: 0.375rem;
  }
  [data-kobe-chat] :where(input, select, textarea):focus-visible {
    outline: none;
    border-color: var(--ring);
    box-shadow: 0 0 0 3px var(--ring);
    @supports (color: color-mix(in lab, red, red)) {
      box-shadow: 0 0 0 3px color-mix(in oklab, var(--ring) 50%, transparent);
    }
  }
}
@property --kobe-arrived {
  syntax: "<percentage>";
  inherits: false;
  initial-value: 100%;
}
@keyframes kobe-arrive {
  from {
    --kobe-arrived: 0%;
  }
  to {
    --kobe-arrived: 100%;
  }
}
[data-kobe-scroll="messages"] {
  --kobe-arrive-tint: currentColor;
}
[data-kobe-scroll="messages"][data-kobe-follow="pinned"] {
  --kobe-arrive-tint: var(--admin-accent, var(--primary));
}
[data-kobe-arrive="running"] [data-kobe-word] {
  color: currentColor;
  @supports (color: color-mix(in lab, red, red)) {
    color: color-mix(in srgb, currentColor var(--kobe-arrived), var(--kobe-arrive-tint));
  }
  animation: kobe-arrive 600ms ease-out;
}
@media (prefers-reduced-motion: reduce) {
  [data-kobe-arrive="running"] [data-kobe-word] {
    animation: none;
  }
  [data-kobe-words] > :is(p, h1, h2, h3, h4, h5, h6, ul, ol) {
    padding-inline-start: 0.5rem;
  }
  [data-kobe-follow="pinned"] [data-kobe-arrive="running"] > :last-child {
    box-shadow: inset 2px 0 0 0 var(--kobe-arrive-tint);
  }
}
