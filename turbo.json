{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js", ".prettierrc.json", ".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["KOBE_BUILD_ID"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "license:check": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "../../pnpm-lock.yaml"],
      "passThroughEnv": ["LICENSE_GATE", "GITHUB_ACTIONS"],
      "cache": false
    },
    "test:db": {
      "dependsOn": ["^build"],
      "env": ["KOBE_TEST_DATABASE_URL", "KOBE_DB_TEST_WORKERS", "KOBE_TEST_DB_LANE"],
      "passThroughEnv": ["CI"],
      "cache": false
    }
  }
}
