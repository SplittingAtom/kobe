{
  "name": "@kobe/license-check",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Dependency license policy check (MIT/Apache/BSD/MPL family only)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "license:check": "node dist/cli.js && node dist/inventory-cli.js check",
    "licenses:update": "node dist/inventory-cli.js update"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
