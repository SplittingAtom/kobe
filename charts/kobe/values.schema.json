{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kobe chart values",
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "memory": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "memory": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            }
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageRegistry": {
          "type": "string",
          "minLength": 1
        },
        "imageTag": {
          "type": "string"
        },
        "imagePullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["name"]
          }
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeClassName": {
          "type": "string",
          "minLength": 1,
          "description": "RuntimeClass for sandboxes; handler must be runsc or kata*"
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 2
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "mcpProxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "egressProxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "bifrost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["external", "cnpg"]
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "appUrlKey": {
              "type": "string",
              "minLength": 1
            },
            "migrateUrlKey": {
              "type": "string",
              "minLength": 1
            },
            "appRole": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]{0,62}$"
            }
          }
        },
        "cnpg": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instances": {
              "type": "integer",
              "minimum": 1
            },
            "imageName": {
              "type": "string",
              "minLength": 1
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                    },
                    {
                      "type": "number",
                      "minimum": 0
                    }
                  ]
                },
                "storageClass": {
                  "type": "string"
                }
              }
            },
            "operatorNamespace": {
              "type": "string",
              "minLength": 1
            },
            "existingAppSecret": {
              "type": "string"
            }
          }
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "external"
          }
        }
      },
      "then": {
        "properties": {
          "external": {
            "properties": {
              "existingSecret": {
                "type": "string",
                "minLength": 1,
                "description": "postgres.external.existingSecret is required when postgres.mode=external"
              }
            }
          }
        }
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "forcePathStyle": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            },
            "clusterIssuer": {
              "type": "string"
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          }
        }
      }
    },
    "clamav": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    }
  },
  "description": "Keys with defaults are not 'required' so `helm upgrade --reuse-values` keeps working when the chart adds keys; mandatory values are enforced with minLength/conditionals."
}
