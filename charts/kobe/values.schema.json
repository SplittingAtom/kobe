{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kobe chart values",
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "memory": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "memory": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            }
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageRegistry": {
          "type": "string",
          "minLength": 1
        },
        "imageTag": {
          "type": "string"
        },
        "imagePullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["name"]
          }
        },
        "allowGeneratedSecretsOffline": {
          "type": "boolean"
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeClassName": {
          "type": "string",
          "minLength": 1,
          "description": "RuntimeClass for sandboxes; handler must be runsc or kata*"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "tmpSize": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "homeSize": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "teamQuota": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z.-]*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          }
        },
        "warmPool": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "replicasPerTeam": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "sessionKeysSecret": {
          "type": "string"
        },
        "ephemeralStorage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "limit": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            }
          }
        },
        "modelGatewayAccess": {
          "type": "boolean"
        },
        "hibernation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "idleMinutes": {
              "type": "integer",
              "minimum": 5,
              "maximum": 60
            },
            "sweepSeconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 3600
            }
          }
        },
        "workspaceSync": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "pushIntervalSeconds": {
              "type": "integer",
              "minimum": 5,
              "maximum": 3600
            },
            "maxFileSize": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
            },
            "maxWorkspaceSize": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?)?$"
            },
            "maxFiles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "collectSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            }
          }
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 2
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "mcpProxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "egressProxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "allowedPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "minItems": 1
        },
        "allowedInternalCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$"
          }
        },
        "deniedCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "connectionsPerSandbox": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "connections": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "bandwidthBytesPerSecond": {
              "type": "integer",
              "minimum": 0
            },
            "idleTimeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "maxTunnelSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "unauthenticatedPerSource": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "unauthenticated": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "restrictEgress": {
              "type": "boolean"
            },
            "databasePeers": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "databasePort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "extraEgress": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "auditFlushSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "bifrost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["external", "cnpg"]
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "appUrlKey": {
              "type": "string",
              "minLength": 1
            },
            "migrateUrlKey": {
              "type": "string",
              "minLength": 1
            },
            "appRole": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]{0,62}$"
            }
          }
        },
        "cnpg": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instances": {
              "type": "integer",
              "minimum": 1
            },
            "imageName": {
              "type": "string",
              "minLength": 1
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                    },
                    {
                      "type": "number",
                      "minimum": 0
                    }
                  ]
                },
                "storageClass": {
                  "type": "string"
                }
              }
            },
            "operatorNamespace": {
              "type": "string",
              "minLength": 1
            },
            "existingAppSecret": {
              "type": "string"
            }
          }
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "external"
          }
        }
      },
      "then": {
        "properties": {
          "external": {
            "properties": {
              "existingSecret": {
                "type": "string",
                "minLength": 1,
                "description": "postgres.external.existingSecret is required when postgres.mode=external"
              }
            }
          }
        }
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "forcePathStyle": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            },
            "clusterIssuer": {
              "type": "string"
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          }
        }
      }
    },
    "clamav": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^(https?://[a-z0-9.-]+(:[0-9]+)?)?$"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "trustedProxies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        }
      }
    },
    "smtp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9.:\\[\\]-]+$",
          "description": "smtp.host is required (spec D7: SMTP is a required value)"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "security": {
          "enum": ["starttls", "tls", "none"]
        },
        "from": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[^\\r\\n]+@[^\\r\\n]+$",
          "description": "smtp.from is required: \"Name <address>\" or an address"
        },
        "existingSecret": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "security": {
            "const": "none"
          }
        }
      },
      "then": {
        "properties": {
          "existingSecret": {
            "maxLength": 0,
            "description": "smtp.security=none would send SMTP credentials unencrypted"
          }
        }
      }
    }
  },
  "description": "Keys with defaults are not 'required' so `helm upgrade --reuse-values` keeps working when the chart adds keys; mandatory values are enforced with minLength/conditionals."
}
