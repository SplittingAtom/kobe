{
  "name": "@kobe/server",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Kobe API server: REST + SSE, auth, runs, policy, sandbox orchestration",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:db": "vitest run -c vitest.db.config.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@hono/node-server": "^2.1.3",
    "@kobe/db": "workspace:*",
    "@kobe/protocol": "workspace:*",
    "@kubernetes/client-node": "^2.0.0",
    "@simplewebauthn/server": "~13.3.3",
    "better-auth": "1.7.7",
    "hono": "^4.13.12",
    "nodemailer": "^10.0.13",
    "pino": "^10.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@levischuck/tiny-cbor": "^0.2.11",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
