{
  "name": "@kobe/server",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Kobe API server: REST + SSE, auth, runs, policy, sandbox orchestration",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:db": "vitest run -c vitest.db.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1147.0",
    "@better-auth/passkey": "1.7.7",
    "@hono/node-server": "^2.1.3",
    "@kobe/address-policy": "workspace:*",
    "@kobe/agent-file": "workspace:*",
    "@kobe/db": "workspace:*",
    "@kobe/protocol": "workspace:*",
    "@kobe/session-token": "workspace:*",
    "@kobe/skill-scanner": "workspace:*",
    "@kobe/telemetry": "workspace:*",
    "@kubernetes/client-node": "^2.0.0",
    "@simplewebauthn/server": "~14.0.3",
    "better-auth": "1.7.7",
    "busboy": "^1.6.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.12",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@kobe/mcp-proxy": "workspace:*",
    "@levischuck/tiny-cbor": "^0.3.6",
    "@types/busboy": "^1.5.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2"
  }
}
