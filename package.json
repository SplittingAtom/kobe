{
  "name": "kobe",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "turbo run license:check",
    "images:check": "scripts/check-images.sh",
    "test:db": "turbo run test:db",
    "db:check": "pnpm --filter @kobe/db run db:check",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && (test -z \"$KOBE_TEST_DATABASE_URL\" || pnpm test:db) && pnpm license:check && scripts/check-public-hygiene.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
