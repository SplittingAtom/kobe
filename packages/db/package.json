{
  "name": "@kobe/db",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Drizzle schema, migrations, RLS policies, cross-team probe suite",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:db": "vitest run -c vitest.db.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit generate && if [ -n \"$(git status --porcelain -- drizzle)\" ]; then git status --porcelain -- drizzle; echo \"Schema changed without a committed migration: run pnpm --filter @kobe/db db:generate\" >&2; exit 1; fi"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "zod": "^4.0.0"
  },
  "bin": {
    "kobe-migrate": "./dist/cli/migrate.js",
    "kobe-db-wait": "./dist/cli/wait.js"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
