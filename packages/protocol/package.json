{
  "name": "@kobe/protocol",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Kobe contracts: event stream, sandbox wire, run orchestrator, policy and approvals",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
